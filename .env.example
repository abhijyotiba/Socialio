# =============================================================================
# SocialOS — environment variables
#
# Copy the relevant section to the right file:
#   web/.env.local   ← only the variables under [WEB]
#   worker/.env      ← only the variables under [WORKER]
#
# These are TWO SEPARATE deploys. The web app does not need worker secrets
# (Cloudinary, OAuth client secrets, LLM keys, service-role key). They moved
# to the worker during the backend migration.
# =============================================================================


# =============================================================================
# [WEB]  →  web/.env.local  (also set the same 4 vars in the Netlify dashboard)
# =============================================================================
# These are the ONLY 4 variables the web app reads at boot. Anything else
# you set here is ignored. See web/lib/env.ts.

NEXT_PUBLIC_SUPABASE_URL=               # Supabase project URL — also exposed to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # Supabase anon key — RLS enforces tenancy; safe to expose
WORKER_URL=http://localhost:8000        # Where the Python worker lives. In prod, your Cloud Run / Render / Fly URL.
WORKER_SHARED_SECRET=                   # openssl rand -hex 32 — HMAC secret. Must match worker's value.


# =============================================================================
# [WORKER]  →  worker/.env  (also set in Fly secrets / Render dashboard / Cloud Run env)
# =============================================================================

# --- Request signing + Supabase ---------------------------------------------
WORKER_SHARED_SECRET=                   # Same value as the web app sets above.
SUPABASE_URL=                           # Same project URL as NEXT_PUBLIC_SUPABASE_URL
SUPABASE_ANON_KEY=                      # Same anon key (worker forwards user JWTs; RLS enforces tenancy)
SUPABASE_JWT_SECRET=                    # Only for legacy HS256 projects; leave empty for asymmetric (JWKS) projects
SUPABASE_SERVICE_ROLE_KEY=              # Service role — ONLY used for Vault reads on the publish path

# --- Cron --------------------------------------------------------------------
CRON_SECRET=                            # openssl rand -hex 32 — Bearer header for /cron/* routes. External scheduler sends this.

# --- Media -------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- LLM providers -----------------------------------------------------------
GROQ_API_KEY=                           # console.groq.com
GEMINI_API_KEY=                         # aistudio.google.com/app/apikey
GROQ_MODEL=llama-3.3-70b-versatile      # Optional; default shown
GEMINI_MODEL=gemini-1.5-flash           # Optional; default shown

# --- OAuth (LinkedIn) --------------------------------------------------------
# Worker reads these via os.environ in adapters/linkedin.py. The /oauth/linkedin/*
# routes will 500 without them. REDIRECT_URI points at the WEB callback path,
# e.g. https://your-app.netlify.app/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# --- OAuth (X / Twitter) -----------------------------------------------------
# Worker reads these via os.environ in adapters/x.py. REDIRECT_URI points at the
# WEB callback path, e.g. https://your-app.netlify.app/api/oauth/x/callback
X_CLIENT_ID=                            # X Developer Portal OAuth 2.0 Client ID
X_CLIENT_SECRET=                        # X Developer Portal OAuth 2.0 Client Secret
X_REDIRECT_URI=

# --- Scraping fallback -------------------------------------------------------
# Recommended in production — cloud egress IPs are usually blocked by anti-bot
# systems. Firecrawl rotates through residential proxies.
FIRECRAWL_API_KEY=                      # firecrawl.dev — 1000 free scrapes/month on the hobby plan
FIRECRAWL_TIMEOUT_S=45                  # Optional; default shown
