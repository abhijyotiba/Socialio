# Web
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=              # openssl rand -hex 32 — Bearer header for the worker's /cron/* routes; external scheduler sends this. Set on both web and worker.

# OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
X_CLIENT_ID=               # X Developer Portal OAuth 2.0 Client ID
X_CLIENT_SECRET=           # X Developer Portal OAuth 2.0 Client Secret
X_REDIRECT_URI=            # e.g. http://localhost:3000/api/oauth/x/callback

# Worker
WORKER_URL=http://localhost:8000   # Local dev. In production, set this to your Cloud Run or Render URL (e.g. https://socialos-worker-xyz.run.app)
WORKER_SHARED_SECRET=              # openssl rand -hex 32 — signs requests from web → worker
PLAYWRIGHT_TIMEOUT_MS=20000
SUPABASE_URL=                      # worker: same project URL as NEXT_PUBLIC_SUPABASE_URL (RLS-scoped DB access)
SUPABASE_ANON_KEY=                 # worker: same anon key as NEXT_PUBLIC_SUPABASE_ANON_KEY (RLS enforces tenancy)
SUPABASE_JWT_SECRET=               # worker: only for legacy HS256 projects; leave empty for asymmetric (JWKS) projects
SUPABASE_SERVICE_ROLE_KEY=         # worker: service role, ONLY for the Vault read on the publish path (bypasses RLS)

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LLM providers (worker)
GROQ_API_KEY=               # Groq console: console.groq.com
GEMINI_API_KEY=             # Google AI Studio: aistudio.google.com/app/apikey
GROQ_MODEL=                 # Default: llama-3.1-70b-versatile
GEMINI_MODEL=               # Default: gemini-1.5-flash

# Scraping fallback — used when local Playwright/HTTPX is blocked by Cloudflare etc.
FIRECRAWL_API_KEY=          # firecrawl.dev — 1000 free scrapes/month on the hobby plan
FIRECRAWL_TIMEOUT_S=45

# Observability
SENTRY_DSN=
