# Web
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=              # openssl rand -hex 32 — Authorization: Bearer header on all /api/cron routes

# OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
X_CLIENT_ID=               # X Developer Portal OAuth 2.0 Client ID
X_CLIENT_SECRET=           # X Developer Portal OAuth 2.0 Client Secret
X_REDIRECT_URI=            # e.g. http://localhost:3000/api/oauth/x/callback

# Worker
WORKER_URL=http://localhost:8000   # Python FastAPI worker base URL
WORKER_SHARED_SECRET=              # openssl rand -hex 32 — signs requests from web → worker
PLAYWRIGHT_TIMEOUT_MS=20000

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LLM providers (worker)
GROQ_API_KEY=               # Groq console: console.groq.com
GEMINI_API_KEY=             # Google AI Studio: aistudio.google.com/app/apikey
GROQ_MODEL=                 # Default: llama-3.1-70b-versatile
GEMINI_MODEL=               # Default: gemini-1.5-flash

# Observability
SENTRY_DSN=
